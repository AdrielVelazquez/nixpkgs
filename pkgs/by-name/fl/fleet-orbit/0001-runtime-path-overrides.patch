+func externalComponentPaths(osquerydPath, desktopPath string, desktopEnabled bool) (string, string, bool) {
+	complete := osquerydPath != "" && (!desktopEnabled || desktopPath != "")
+	return osquerydPath, desktopPath, complete
+}
+
+func configuredPath(value, fallback string) string {
+	if value != "" {
+		return value
+	}
+	return fallback
+}
+
+func linuxBrowserPath(value string, pathExists func(string) bool) string {
+	if value != "" {
+		return value
+	}
+	if pathExists("/usr/bin/firefox") {
+		return "/usr/bin/firefox"
+	}
+	return "/usr/bin/xdg-open"
+}
+
+func updateRunnerTargets(externalComponentsComplete, desktopEnabled, devMode bool) ([]string, bool) {
+	targets := []string{constant.OrbitTUFTargetName}
+	if !externalComponentsComplete {
+		targets = append(targets, constant.OsqueryTUFTargetName)
+		if desktopEnabled {
+			targets = append(targets, constant.DesktopTUFTargetName)
+		}
+	}
+	if devMode {
+		targets = targets[1:]
+	}
+	return targets, len(targets) == 0
+}
