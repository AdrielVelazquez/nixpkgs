index 3975b54..53228b3 100644
--- a/orbit/cmd/orbit/orbit.go
+++ b/orbit/cmd/orbit/orbit.go
@@ -111,6 +111,26 @@ func main() {
 			Usage:   "Path to the Fleet server certificate chain",
 			EnvVars: []string{"ORBIT_FLEET_CERTIFICATE"},
 		},
+		&cli.StringFlag{
+			Name:    "osqueryd-path",
+			Usage:   "Use an externally managed osqueryd executable",
+			EnvVars: []string{"ORBIT_OSQUERYD_PATH"},
+		},
+		&cli.StringFlag{
+			Name:    "desktop-path",
+			Usage:   "Use an externally managed Fleet Desktop executable",
+			EnvVars: []string{"ORBIT_DESKTOP_PATH"},
+		},
+		&cli.StringFlag{
+			Name:    "osquery-log-path",
