+func TestExternalComponentPaths(t *testing.T) {
+	tests := []struct {
+		name           string
+		osquerydPath   string
+		desktopPath    string
+		desktopEnabled bool
+		complete       bool
+	}{
+		{
+			name:         "osquery only",
+			osquerydPath: "/nix/store/osqueryd",
+			complete:     true,
+		},
+		{
+			name:           "desktop complete",
+			osquerydPath:   "/nix/store/osqueryd",
+			desktopPath:    "/nix/store/fleet-desktop",
+			desktopEnabled: true,
+			complete:       true,
+		},
+		{
+			name:           "missing osquery",
+			desktopPath:    "/nix/store/fleet-desktop",
+			desktopEnabled: true,
+		},
+		{
+			name:           "missing desktop",
+			osquerydPath:   "/nix/store/osqueryd",
+			desktopEnabled: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			osquerydPath, desktopPath, complete := externalComponentPaths(
+				tt.osquerydPath,
+				tt.desktopPath,
+				tt.desktopEnabled,
+			)
+			require.Equal(t, tt.osquerydPath, osquerydPath)
+			require.Equal(t, tt.desktopPath, desktopPath)
+			require.Equal(t, tt.complete, complete)
+		})
+	}
+}
+
+func TestConfiguredPath(t *testing.T) {
+	require.Equal(t, "/configured", configuredPath("/configured", "/fallback"))
+	require.Equal(t, "/fallback", configuredPath("", "/fallback"))
+}
+
+func TestLinuxBrowserPath(t *testing.T) {
+	statCalls := 0
+	pathExists := func(path string) bool {
+		statCalls++
+		return path == "/usr/bin/firefox"
+	}
+
+	require.Equal(t, "/nix/store/xdg-open", linuxBrowserPath("/nix/store/xdg-open", pathExists))
+	require.Zero(t, statCalls, "an explicit browser must bypass hardcoded path lookup")
+	require.Equal(t, "/usr/bin/firefox", linuxBrowserPath("", pathExists))
+	require.Equal(t, "/usr/bin/xdg-open", linuxBrowserPath("", func(string) bool { return false }))
+}
+
+func TestUpdateRunnerTargets(t *testing.T) {
+	tests := []struct {
+		name                       string
+		externalComponentsComplete bool
+		desktopEnabled             bool
+		devMode                    bool
+		want                       []string
+		allowEmpty                 bool
+	}{
+		{
+			name: "managed components",
+			want: []string{constant.OrbitTUFTargetName, constant.OsqueryTUFTargetName},
+		},
+		{
+			name:           "managed desktop",
+			desktopEnabled: true,
+			want: []string{
+				constant.OrbitTUFTargetName,
+				constant.OsqueryTUFTargetName,
+				constant.DesktopTUFTargetName,
+			},
+		},
+		{
+			name:    "managed dev mode",
+			devMode: true,
+			want:    []string{constant.OsqueryTUFTargetName},
+		},
+		{
+			name:                       "external components",
+			externalComponentsComplete: true,
+			want:                       []string{constant.OrbitTUFTargetName},
+		},
+		{
+			name:                       "external components in dev mode",
+			externalComponentsComplete: true,
+			devMode:                    true,
+			want:                       []string{},
+			allowEmpty:                 true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			targets, allowEmpty := updateRunnerTargets(
+				tt.externalComponentsComplete,
+				tt.desktopEnabled,
+				tt.devMode,
+			)
+			require.Equal(t, tt.want, targets)
+			require.Equal(t, tt.allowEmpty, allowEmpty)
+		})
+	}
+}
