-		},
-			// retry every 5 minutes to not flood the logs,
-			// but actual pings to the remote server are
-			// handled by `updater.Get`
-			retrypkg.WithInterval(5*time.Minute),
-		)
-		if err != nil {
-			// this should never happen because `retry.Do` is
